{
  "manifestVersion": 1,
  "id": "lunaris.component-provider",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [
    { "kind": "api", "id": "lunaris.views", "version": "1.0.0" },
    {
      "kind": "api",
      "id": "lunaris.components",
      "version": "1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.components-changed",
      "version": "1.0.0"
    }
  ],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    }
  ],
  "permissions": [
    "ui.dom"
  ],
  "optionalPermissions": []
}
