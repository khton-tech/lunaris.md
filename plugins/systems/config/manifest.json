{
  "manifestVersion": 1,
  "id": "lunaris.config-manager",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [
    { "kind": "api", "id": "lunaris.config-snapshots", "version": "1.0.0" },
    {
      "kind": "api",
      "id": "lunaris.config",
      "version": "1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.config-changed",
      "version": "1.0.0"
    }
  ],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.filesystem",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.application-directory",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0"
    },
    {
      "kind": "hook",
      "id": "lunaris.prepare-vault",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    }
  ],
  "permissions": [
    "filesystem.access",
    "filesystem.app-config",
    "vault.access"
  ],
  "optionalPermissions": []
}
