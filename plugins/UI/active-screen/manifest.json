{
  "manifestVersion": 1,
  "id": "lunaris.active-screen",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-screen",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.active-screen-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.workspace",
      "range": "^1.1.0"
    },
    {
      "kind": "api",
      "id": "lunaris.components",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.components-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.localization",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.locale-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.mobile-menu",
      "range": "^1.5.0",
      "optional": true
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "kind": "api",
      "id": "lunaris.active-document",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "kind": "event",
      "id": "lunaris.active-document-transitioned",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "kind": "hook",
      "id": "lunaris.before-file-mutation",
      "range": "^1.0.0",
      "optional": true
    }
  ],
  "permissions": [
    "ui.dom"
  ],
  "optionalPermissions": ["vault.access", "filesystem.access"]
}
