{
  "manifestVersion": 1,
  "id": "lunaris.file-explorer",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.sidebar",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem-observation",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.filesystem-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.vault-changed",
      "range": "^1.1.0"
    },
    {
      "kind": "api",
      "id": "lunaris.localization",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.locale-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.context-menu",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-document",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.active-document-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault-history",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.vault-history-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.config",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.config-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.settings",
      "range": "^1.2.0"
    }
  ],
  "permissions": [
    "filesystem.access",
    "vault.access",
    "config.access"
  ],
  "optionalPermissions": []
}
