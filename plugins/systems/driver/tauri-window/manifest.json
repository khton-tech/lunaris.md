{
  "manifestVersion": 1,
  "id": "lunaris.tauri-window",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [
    {
      "kind": "api",
      "id": "lunaris.window-driver",
      "version": "1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.driver-window-changed",
      "version": "1.0.0"
    }
  ],
  "requires": [
