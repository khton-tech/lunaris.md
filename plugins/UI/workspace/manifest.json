{
  "manifestVersion": 1,
  "id": "lunaris.workspace",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.localization",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.slots",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.slot-dom",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.components",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.startup",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.startup-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.locale-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.components-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.vault-changed",
      "range": "^1.1.0"
    },
    {
      "kind": "api",
      "id": "lunaris.workspace",
      "range": "^1.1.0"
    },
    {
      "kind": "event",
      "id": "lunaris.workspace-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.config",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.workspace-sidebar",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.preparation",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "kind": "event",
      "id": "lunaris.preparation-changed",
      "range": "^1.0.0",
      "optional": true
    }
  ],
  "permissions": [
    "ui.dom",
    "vault.access",
    "config.access"
  ],
  "optionalPermissions": []
}
