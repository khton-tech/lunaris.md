{
  "name": "lunaris",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "lunaris",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "6.0.3"
      },
      "engines": {
        "node": ">=26.13.0 <27",
        "npm": ">=11 <12"
      }
    },
    "node_modules/@lunaris/kernel": {
      "resolved": "packages/kernel",
      "link": true
    },
    "node_modules/@lunaris/manifest": {
      "resolved": "packages/manifest",
      "link": true
    },
    "node_modules/@lunaris/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/typescript": {
      "version": "6.0.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz",
      "integrity": "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/kernel": {
      "name": "@lunaris/kernel",
      "version": "0.1.0",
      "dependencies": {
        "@lunaris/manifest": "0.1.0",
        "@lunaris/sdk": "0.1.0"
      }
    },
    "packages/manifest": {
      "name": "@lunaris/manifest",
      "version": "0.1.0"
    },
    "packages/sdk": {
      "name": "@lunaris/sdk",
      "version": "0.1.0",
      "dependencies": {
        "@lunaris/manifest": "0.1.0"
      }
    }
  }
}
