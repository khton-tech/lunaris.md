{
  "manifestVersion": 1,
  "id": "lunaris.text-editor",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-document",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.active-document-transitioned",
      "range": "^1.0.0"
    },
    {
      "kind": "hook",
      "id": "lunaris.before-active-document-change",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-screen",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem",
      "range": "^1.0.0"
    },
    {
      "kind": "hook",
      "id": "lunaris.before-file-mutation",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.filesystem-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.vault-changed",
      "range": "^1.1.0"
    },
    {
      "kind": "hook",
      "id": "lunaris.before-vault-release",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.components",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.components-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.localization",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.locale-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.themes",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.theme-changed",
      "range": "^1.0.0"
    }
  ],
  "permissions": [
    "ui.dom",
    "vault.access",
    "filesystem.access"
  ],
  "optionalPermissions": []
}
