{
  "manifestVersion": 1,
  "id": "lunaris.backlinks-ui",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.backlinks",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.backlinks-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.document-content",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-document",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.active-document-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.document-footers",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.sidebar",
      "range": "^1.1.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-screen",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.components",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.components-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.localization",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.locale-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.vault-changed",
      "range": "^1.1.0"
    },
    {
      "kind": "api",
      "id": "lunaris.config",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.config-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.settings",
      "range": "^1.0.0"
    }
  ],
  "permissions": [
    "ui.dom",
    "vault.access",
    "config.access"
  ],
  "optionalPermissions": []
}
