{
  "manifestVersion": 1,
  "id": "lunaris.filesystem-provider",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [
    {
      "kind": "api",
      "id": "lunaris.application-directory",
      "version": "1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem-roots",
      "version": "1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem",
      "version": "1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.filesystem-changed",
      "version": "1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem-locations",
      "version": "1.1.0"
    }
  ],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.filesystem-roots-driver",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.application-directory-driver",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem-driver",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.filesystem-driver-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem-locations-driver",
      "range": "^1.1.0"
    }
  ],
  "permissions": [
    "filesystem.app-config",
    "filesystem.access"
  ],
  "optionalPermissions": []
}
