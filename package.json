{
  "name": "lunaris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "hosts/*",
    "plugins/systems/*",
    "plugins/systems/driver/*",
    "plugins/UI/*"
  ],
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "toolchain:build": "node tools/scripts/plugin-toolchain.mjs",
    "lime:dx": "node tools/scripts/lime-dx.mjs",
    "dev:server": "node tools/scripts/server-dev.mjs",
    "server:check": "node tools/scripts/server-check.mjs",
    "web:dev": "npm run dev --workspace @lunaris/web",
    "web:build": "npm run build --workspace @lunaris/web",
    "remote:check": "node tools/scripts/remote.mjs",
    "environment": "node tools/scripts/environment.mjs",
    "build": "tsc -b",
    "check": "node tools/scripts/check.mjs",
    "core": "node packages/cli/dist/bin.js",
    "rehearse": "node tools/scripts/rehearse.mjs",
    "ci": "node tools/scripts/ci.mjs",
    "audit": "node tools/scripts/audit.mjs",
    "benchmark": "node tools/scripts/benchmark.mjs",
    "release:check": "node tools/scripts/release.mjs",
    "tauri:dev": "npm run desktop:dev --workspace @lunaris/tauri",
    "tauri:check": "node tools/scripts/tauri.mjs check",
    "logger:check": "node tools/scripts/check.mjs logging logger dev-tools-logger",
    "filesystem:check": "node tools/scripts/filesystem.mjs",
    "vault:check": "node tools/scripts/check.mjs vault vault-manager filesystem-provider tauri-filesystem",
    "config:check": "node tools/scripts/check.mjs config config-manager",
    "tauri:build": "node tools/scripts/tauri.mjs build",
    "localization:check": "node tools/scripts/check.mjs localization localization-manager",
    "ui-localization:check": "node tools/scripts/ui-localization.mjs",
    "slots:check": "node tools/scripts/check.mjs slots slot-dom slot-provider web-slot-driver",
    "themes:check": "node tools/scripts/check.mjs themes theme-provider",
    "components:check": "node tools/scripts/check.mjs components component-provider",
    "base-theme:check": "node tools/scripts/check.mjs base-theme-engine",
    "startup:check": "node tools/scripts/check.mjs startup startup-provider",
    "components-kit:check": "node tools/scripts/check.mjs components-kit",
    "theme-settings:check": "node tools/scripts/check.mjs theme-settings base-theme-engine mantine-components",
    "runner:check": "node tools/scripts/check.mjs runner",
    "vault-history:check": "node tools/scripts/check.mjs vault-history",
    "vault-selector:check": "node tools/scripts/check.mjs vault-selector mantine-components runner",
    "mantine-components:check": "node tools/scripts/check.mjs mantine-components runner vault-selector",
    "workspace:check": "node tools/scripts/check.mjs workspace workspace-provider workspace-plugin mantine-components vault-selector",
    "sidebar:check": "node tools/scripts/check.mjs sidebar sidebar-provider sidebar-plugin workspace workspace-provider workspace-plugin mantine-components",
    "file-explorer:check": "node tools/scripts/check.mjs file-explorer mantine-components sidebar-plugin",
    "context-menu:check": "node tools/scripts/check.mjs context-menu context-menu-provider file-explorer mantine-components",
    "active-document:check": "node tools/scripts/check.mjs active-document active-document-provider file-explorer mantine-components",
    "active-screen:check": "node tools/scripts/check.mjs active-screen active-screen-provider active-screen-plugin mantine-components",
    "settings:check": "node tools/scripts/check.mjs settings settings-provider settings-plugin",
    "interface-settings:check": "node tools/scripts/check.mjs interface-settings settings-plugin mantine-components",
    "editor:check": "node tools/scripts/editor.mjs",
    "window:check": "node tools/scripts/check.mjs window window-provider tauri-window window-titlebar",
    "status-bar:check": "node tools/scripts/check.mjs status-bar workspace-plugin workspace-provider text-editor server-transport mantine-components",
    "editor-menu:check": "node tools/scripts/check.mjs context-menu context-menu-provider clipboard clipboard-provider browser-clipboard text-editor mantine-components",
    "callouts:check": "node tools/scripts/check.mjs callouts mantine-components text-editor"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "fake-indexeddb": "6.2.7",
    "typescript": "6.0.3"
  }
}
