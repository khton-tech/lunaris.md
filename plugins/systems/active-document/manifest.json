{
  "manifestVersion": 1,
  "id": "lunaris.active-document-provider",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [
    {
      "kind": "api",
      "id": "lunaris.active-document",
      "version": "1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.active-document-changed",
      "version": "1.0.0"
    }
  ],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.config",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.vault-changed",
      "range": "^1.1.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem",
      "range": "^1.0.0"
    }
  ],
  "permissions": [
    "vault.access",
    "config.access",
    "filesystem.access"
  ],
  "optionalPermissions": []
}
