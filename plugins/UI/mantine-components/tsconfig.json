{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ESNext.Collection"
    ],
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-dom"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "manifest.json",
    "src/**/*.tsx"
  ],
  "references": [
    {
      "path": "../../../packages/sdk"
    },
    {
      "path": "../../../packages/logging"
    },
    {
      "path": "../../../packages/components"
    },
    {
      "path": "../../../packages/themes"
    },
    {
      "path": "../../../packages/context-menu"
    }
  ]
}
