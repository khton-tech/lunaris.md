{
  "manifestVersion": 1,
  "id": "lunaris.text-editor",
  "version": "0.1.0",
  "engine": "^0.1.0",
  "sdk": "^0.1.0",
  "entry": "./dist/src/index.js",
  "provides": [
    {
      "kind": "api",
      "id": "lunaris.document-protection",
      "version": "1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.document-statistics",
      "version": "1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.document-statistics-changed",
      "version": "1.0.0"
    }
  ],
  "requires": [
    {
      "kind": "api",
      "id": "lunaris.logger",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-document",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.active-document-transitioned",
      "range": "^1.0.0"
    },
    {
      "kind": "hook",
      "id": "lunaris.before-active-document-change",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.active-screen",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem",
      "range": "^1.0.0"
    },
    {
      "kind": "hook",
      "id": "lunaris.before-file-mutation",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.filesystem-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.vault",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.vault-changed",
      "range": "^1.1.0"
    },
    {
      "kind": "hook",
      "id": "lunaris.before-vault-release",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.components",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.components-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.localization",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.locale-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.themes",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.theme-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.drafts",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "kind": "api",
      "id": "lunaris.filesystem-sources",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "kind": "event",
      "id": "lunaris.connection-changed",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "kind": "api",
      "id": "lunaris.context-menu",
      "range": "^1.1.0"
    },
    {
      "kind": "api",
      "id": "lunaris.clipboard",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.config",
      "range": "^1.0.0"
    },
    {
      "kind": "event",
      "id": "lunaris.config-changed",
      "range": "^1.0.0"
    },
    {
      "kind": "api",
      "id": "lunaris.settings",
      "range": "^1.2.0"
    }
  ],
  "permissions": [
    "ui.dom",
    "vault.access",
    "filesystem.access",
    "clipboard.access",
    "config.access"
  ],
  "optionalPermissions": [
    "drafts.access",
    "account.access"
  ]
}
